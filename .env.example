# Session secret (change in production)
SESSION_SECRET=change-me-please-long-random-string

# Port (Render/Railway set this automatically)
PORT=3000

# Office365 SMTP (use an App Password if MFA is enabled)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourdomain.com

# Name of the meeting room shown in invites
ROOM_NAME=Salle de réunion - Les Vennes
ROOM_LOCATION=Les Vennes, Liège
